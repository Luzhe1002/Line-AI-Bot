APP_ENVIRONMENT=development

# Optional for a local Java process. Docker Compose overrides these values.
SPRING_DATASOURCE_URL=jdbc:h2:file:./line_ai_bot_java;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Production must use long, randomly generated values from a secret manager.
APP_ENCRYPTION_KEY=change-this-development-encryption-key
APP_PLATFORM_ADMIN_API_KEY=change-this-platform-admin-key

APP_LINE_API_ENABLED=false
APP_LINE_API_BASE_URL=https://api.line.me
APP_LINE_WORKER_ENABLED=true
APP_LINE_WORKER_DELAY_MS=250
APP_LINE_WORKER_CONCURRENCY=8
APP_PUBLIC_BASE_URL=http://localhost:8000
APP_SESSION_COOKIE_SECURE=false

APP_AI_PROVIDER=local
APP_AI_GENERATION_MODEL=gpt-5.6-luna
APP_AI_EMBEDDING_MODEL=text-embedding-3-small
APP_AI_EMBEDDING_DIMENSIONS=512
APP_AI_REASONING_EFFORT=none
APP_AI_MIN_RETRIEVAL_SCORE=0.20
APP_AI_MAX_CONTEXT_DOCUMENTS=4
APP_AI_MAX_CONTEXT_CHARS=6000
APP_AI_CHUNK_SIZE_CHARS=1200
APP_AI_CHUNK_OVERLAP_CHARS=150
APP_AI_MAX_OUTPUT_TOKENS=500
APP_AI_TIMEOUT_SECONDS=20

# Only required after APP_AI_PROVIDER is changed to openai.
OPENAI_API_KEY=
